{
  "name": "@pineberry/muroora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local db/seed.ts",
    "db:verify": "node --env-file=.env.local db/verify.mjs",
    "db:verify-staff": "node --env-file=.env.local db/verify-staff.mjs",
    "db:verify-staff-service": "tsx --env-file=.env.local db/verify-staff-service.mts",
    "db:verify-orders": "tsx --env-file=.env.local db/verify-orders.mts",
    "db:verify-access": "tsx --env-file=.env.local db/verify-access.mts",
    "db:verify-riders": "tsx --env-file=.env.local db/verify-riders.mts",
    "db:verify-marketplace": "tsx --env-file=.env.local db/verify-marketplace.mts",
    "db:grant": "tsx --env-file=.env.local db/grant-role.ts"
  },
  "dependencies": {
    "@pineberry/ui": "*",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.0",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
