# Muroora Mart — environment
#
# Copy to .env.local and fill in. .env.local is gitignored.
# NEVER commit real values. See docs/12_ENVIRONMENT_VARIABLES.md.

# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string
#
# DATABASE_URL  = the POOLED string, port 6543, with ?pgbouncer=true
#                 Used by the running app. Serverless opens a connection per
#                 invocation and would exhaust the direct limit without it.
#
# DIRECT_URL    = the DIRECT string, port 5432
#                 Used by drizzle-kit for migrations only. DDL through the
#                 pooler is unreliable in transaction mode.
DATABASE_URL=
DIRECT_URL=

# ---------------------------------------------------------------------------
# Supabase (auth + private storage)
# ---------------------------------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses row-level security entirely.
# Never prefix with NEXT_PUBLIC_, never import into a client component, never
# log it. Anything holding this key can read every rider's ID document.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Store
# ---------------------------------------------------------------------------
# The Muroora Mart store row's UUID, from the seed. Every query is scoped to it.
NEXT_PUBLIC_STORE_ID=

# ---------------------------------------------------------------------------
# WhatsApp — no number yet
# ---------------------------------------------------------------------------
# The brief: do not hard-code a fake number. Left blank, every WhatsApp CTA is
# hidden rather than rendering a broken link. Full international, no
# punctuation: 263771234567
WHATSAPP_BUSINESS_NUMBER=

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# Checkout is off until a payment method is confirmed and real stock is loaded.
NEXT_PUBLIC_ENABLE_CHECKOUT=false
NEXT_PUBLIC_ENABLE_ACCOUNTS=false
ENABLE_SENSITIVE_RIDER_VERIFICATION=false

# ---------------------------------------------------------------------------
# Which website this deployment is
# ---------------------------------------------------------------------------
# One codebase serves two sites. See lib/brand.ts.
#
#   musuwo   the marketplace. `/` is the business directory. THE DEFAULT.
#   muroora  Muroora Mart's own shop. `/` is its storefront.
#
# NEXT_PUBLIC_ because the navigation is a client component and has to know
# which logo to draw. There is nothing secret in it.
NEXT_PUBLIC_SITE_BRAND=musuwo

# This deployment's own public origin, no trailing slash.
#
# NOT optional in production. It sets the canonical and Open Graph URLs, and it
# is the address the password-reset email sends people back to. Left unset, the
# app falls back to the brand's own URL in lib/brand.ts, which is right for the
# two live sites and wrong for every preview deployment.
NEXT_PUBLIC_SITE_URL=https://musuwo.vercel.app

# ---------------------------------------------------------------------------
# Telling applicants what happened
# ---------------------------------------------------------------------------
# Brevo, which already sends the password-reset email. One account, one sender
# identity, one free allowance (300/day - far beyond a pilot). NO NEW PAID
# SERVICE.
#
# Get it from Brevo -> SMTP & API -> API Keys.
#
# Without it, approvals and requests for information are recorded but NOT
# emailed. The Control Center says so plainly and offers a WhatsApp button
# instead, so nothing silently goes nowhere.
BREVO_API_KEY=
# Must be a sender Brevo has verified, or it will refuse the message.
BREVO_SENDER_EMAIL=no-reply@musuwo.online

# There is deliberately no SMS. Every route to a Zimbabwean number is paid -
# a gateway account, a registered sender ID and a per-message charge. That is
# a decision for the owner, not something to slip in. See lib/platform/notify.ts.
