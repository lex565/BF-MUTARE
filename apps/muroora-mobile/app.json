{
  "expo": {
    "name": "Musuwo Beta",
    "slug": "musuwo",
    "version": "0.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "scheme": "musuwo",
    "description": "Musuwo Beta — private test release. Discover local businesses, products, food, accommodation and services.",
    "orientation": "portrait",
    "icon": "./assets/musuwo-app-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFDF8",
    "plugins": [
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8ED",
          "image": "./assets/musuwo-splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Musuwo uses the camera to photograph identity documents for secure verification.",
          "photosPermission": "Musuwo can access selected identity photos for secure verification.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Musuwo uses your location to add a precise delivery pin to the address you type."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "buildNumber": "2",
      "bundleIdentifier": "zw.co.musuwo.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8ED",
        "foregroundImage": "./assets/musuwo-icon-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 2,
      "package": "zw.co.musuwo.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "muroora-mart",
    "extra": {
      "eas": {
        "projectId": "1da99634-840e-4cf1-8e23-60e6cb560d68"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/1da99634-840e-4cf1-8e23-60e6cb560d68"
    }
  }
}
